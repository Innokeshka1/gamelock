# Public Supabase configuration; replace these placeholders locally.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Payments: mock | stellar-native | trustless-work (preparation-only).
# Set stellar-native to enable direct EURC Testnet transfers via Freighter.
